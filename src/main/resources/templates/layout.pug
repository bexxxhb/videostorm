doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    if metaRefreshSeconds
      meta(http-equiv="refresh", content=metaRefreshSeconds)
    title Videostorm
    link(rel="stylesheet", href="/css/videostorm.css")
  body
    header.masthead
      a.masthead__brand(href="/") Videostorm
      a.masthead__link(href="/maintenance") Maintenance
    nav.tabs
      if activeTab === "movies"
        a.tab.tab--active(href="/movies") Movies
      else
        a.tab(href="/movies") Movies
      if activeTab === "shows"
        a.tab.tab--active(href="/shows") Shows
      else
        a.tab(href="/shows") Shows
    main.content
      block content
    dialog.plot-dialog#plot-dialog
      .plot-dialog__panel
        .plot-dialog__head
          h2.plot-dialog__title
          button.plot-dialog__close(type="button", aria-label="Close") ×
        .plot-dialog__body
    script(src="/js/plot-dialog.js", defer)
