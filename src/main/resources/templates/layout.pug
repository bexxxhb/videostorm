doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Videostorm
    link(rel="stylesheet", href="/css/videostorm.css")
  body
    header.masthead
      a.masthead__brand(href="/") Videostorm
    nav.tabs
      if activeTab === "movies"
        a.tab.tab--active(href="/movies") Movies
      else
        a.tab(href="/movies") Movies
      if activeTab === "shows"
        a.tab.tab--active(href="/shows") Shows
      else
        a.tab(href="/shows") Shows
    main.content
      block content
