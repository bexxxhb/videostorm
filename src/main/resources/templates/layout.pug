doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    if metaRefreshSeconds
      meta(http-equiv="refresh", content=metaRefreshSeconds)
    title Videostorm
    link(rel="stylesheet", href="/css/videostorm.css")
  body
    header.masthead
      a.masthead__home(href="/", aria-label="Videostorm home")
      if maintenanceEnabled
        if administratorAuthenticated
          a.masthead__link(href="/maintenance") Maintenance
        else
          a.masthead__link#login-layer-trigger(href="/maintenance") Maintenance
    nav.tabs
      if activeTab === "movies"
        a.tab.tab--active(href="/movies") Movies
      else
        a.tab(href="/movies") Movies
      if activeTab === "shows"
        a.tab.tab--active(href="/shows") Shows
      else
        a.tab(href="/shows") Shows
    main.content
      block content
    dialog.content-dialog#content-dialog
      .content-dialog__panel
        .content-dialog__head
          h2.content-dialog__title
          button.content-dialog__close(type="button", aria-label="Close") ×
        .content-dialog__body
    if maintenanceEnabled && !administratorAuthenticated
      dialog.content-dialog#login-layer(data-login-failed=loginFailed)
        .content-dialog__panel
          .content-dialog__head
            h2.content-dialog__title Sign in
            button.content-dialog__close(type="button", aria-label="Close") ×
          .content-dialog__body
            if loginFailed
              p.form__error Invalid username or password.
            form.form(method="post", action="/login")
              input(type="hidden", name=csrfParameterName, value=csrfToken)
              input(type="hidden", name="returnTo", value=loginReturnPath)
              label.field
                span Username
                input(type="text", name="username", autofocus)
              label.field
                span Password
                input(type="password", name="password")
              button.button(type="submit") Sign in
    script(src="/js/content-dialog.js", defer)
    script(src="/js/search.js", defer)
    if maintenanceEnabled && !administratorAuthenticated
      script(src="/js/login-layer.js", defer)
