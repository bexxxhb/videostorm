extends layout

block content
  h1 Maintenance
  form.form(method="post", action="/logout")
    input(type="hidden", name=csrfParameterName, value=csrfToken)
    button.button(type="submit") Log out

  if unreachablePaths
    section.preflight-error(role="alert")
      h2 Re-index aborted
      p.preflight-error__lead The #{unreachableType} re-index did not run: these source paths are unreachable. The catalogue was left untouched.
      ul.preflight-error__paths
        each path in unreachablePaths
          li= path

  if activeRun
    section.run-status
      h2 Run in progress
      p.run-status__line #{activeRun.type} — #{activeRun.status}, started #{activeRun.startedAt}

  section.trigger
    h2 Movies
    form.form(method="post", action="/maintenance/movies/reindex")
      input(type="hidden", name=csrfParameterName, value=csrfToken)
      button.button(type="submit", disabled=(!moviesConfigured || runActive)) Re-index movies
    if !moviesConfigured
      p.trigger__note No movie source paths are configured; nothing to re-index.

  section.trigger
    h2 Shows
    form.form(method="post", action="/maintenance/shows/reindex")
      input(type="hidden", name=csrfParameterName, value=csrfToken)
      button.button(type="submit", disabled=(!showsConfigured || runActive)) Re-index shows
    if !showsConfigured
      p.trigger__note No show source paths are configured; nothing to re-index.

  section.gaps
    h2 Gaps in the last run
    ul.gaps__list
      li.gaps__item Missing title: #{titleGaps}
      li.gaps__item Missing year: #{yearGaps}

  section.duplicates
    h2 Duplicate movies
    form.form(method="post", action="/maintenance/duplicates/scan")
      input(type="hidden", name=csrfParameterName, value=csrfToken)
      button.button(type="submit") Scan for duplicate movies
    if hasDuplicateScans
      table.duplicates__table
        thead
          tr
            th Executed
            th Duration
            th Groups
            th Duplicates
        tbody
          each scan in duplicateScans
            tr
              td= scan.executedAt
              td= scan.duration
              td= scan.groupCount
              td
                if scan.hasGroups
                  a.duplicates-link(href="/maintenance/duplicate-scans/" + scan.id + "/groups", data-title="Duplicate movies — " + scan.executedAt) View duplicates
    else
      p.duplicates__empty No duplicate scans yet.

  section.history
    h2 Run history
    if hasRuns
      table.history__table
        thead
          tr
            th Type
            th Status
            th Started
            th Finished
            th Found
            th Indexed
            th Skipped
            th Missing data
            th Report
        tbody
          each run in runs
            tr
              td= run.type
              td= run.status
              td= run.startedAt
              td= run.finishedAt
              td= run.found
              td= run.indexed
              td= run.skipped
              td= run.missingData
              td
                if run.downloadable
                  a.history__download(href="/maintenance/runs/" + run.id + "/report.csv") Download CSV
    else
      p.history__empty No runs yet.
