extends layout

include mixins/pagination

block content
  form.search(method="get", action="/shows")
    input.search__input(type="search", name="q", value=query, placeholder="Search title, genre or started")
    input(type="hidden", name="sort", value=sort.field)
    input(type="hidden", name="dir", value=sort.direction)
    button.search__button(type="submit") Search

  +pagination(pagination, pageNumber, totalPages, totalElements)

  table.catalogue
    thead
      tr
        th #
        th
          a.sort-link(href=sort.title.url) Title !{sort.title.marker}
        th
          a.sort-link(href=sort.year.url) Started !{sort.year.marker}
        th Status
        th
          a.sort-link(href=sort.rating.url) Rating !{sort.rating.marker}
        th Genres
        th Seasons
        th Total Episodes
        th Plot
        th Actors
        th IMDb
        th nfo raw
    tbody
      each show in shows
        tr(class=show.rowClass)
          td= show.indexDisplay
          td= show.title
          td= show.year
          td= show.statusDisplay
          td= show.ratingDisplay
          td(title=show.genresFullText)= show.genresDisplay
          td= show.seasonsDisplay
          td= show.episodesDisplay
          td
            if show.hasPlot
              a.plot-link(href="#", data-plot=show.plotBase64, data-title=show.title) Plot
          td
            if show.hasActors
              a.actors-link(href=show.actorsUrl, data-title=show.title) Actors
          td
            if show.imdbUrl
              a.imdb-link(href=show.imdbUrl)= show.imdbLinkText
          td
            if show.hasRawNfo
              a.rawnfo-link(href=show.rawNfoUrl, data-title=show.title) Raw data

  +pagination(pagination, pageNumber, totalPages, totalElements)
