include mixins/pagination

+pagination(pagination, pageNumber, totalPages, totalElements)

table.catalogue
  colgroup
    col.col--index
    col.col--title
    col.col--year
    col.col--rating
    col.col--genres
    col.col--runtime
    col.col--resolution
    col.col--plot
    col.col--actors
    col.col--imdb
    col.col--rawnfo
  thead
    tr
      th #
      th
        a.sort-link(href=sort.title.url) Title !{sort.title.marker}
      th
        a.sort-link(href=sort.year.url) Year !{sort.year.marker}
      th
        a.sort-link(href=sort.rating.url) Rating !{sort.rating.marker}
      th Genres
      th Runtime
      th
        a.sort-link(href=sort.resolution.url) Resolution !{sort.resolution.marker}
      th Plot
      th Actors
      th IMDb
      th nfo raw
  tbody
    each movie in movies
      tr(class=movie.rowClass)
        td= movie.indexDisplay
        td= movie.title
        td= movie.year
        td= movie.ratingDisplay
        td(title=movie.genresFullText)= movie.genresDisplay
        td= movie.runtimeDisplay
        td= movie.resolutionDisplay
        td
          if movie.hasPlot
            a.plot-link(href="#", data-plot=movie.plotBase64, data-title=movie.title) Plot
        td
          if movie.hasActors
            a.actors-link(href=movie.actorsUrl, data-title=movie.title) Actors
        td
          if movie.imdbUrl
            a.imdb-link(href=movie.imdbUrl, target="_blank", rel="noopener noreferrer")= movie.imdbLinkText
        td
          if movie.hasRawNfo
            a.rawnfo-link(href=movie.rawNfoUrl, data-title=movie.title) Raw data

+pagination(pagination, pageNumber, totalPages, totalElements)
